# ---- Copy this file to ".env" and fill in your own values ----

# PayPal sandbox REST app credentials.
# Get them free at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your-sandbox-client-id
PAYPAL_CLIENT_SECRET=your-sandbox-client-secret

# "sandbox" (default) or "live". Keep this on sandbox for the hackathon.
PAYPAL_ENV=sandbox

# Default invoice currency when the user doesn't specify one (default USD).
# PayPal supports USD, EUR, GBP, AUD, CAD, SGD, JPY and more — but NOT INR.
# DEFAULT_CURRENCY=USD

# Google Gemini API key for the model that drives the agent.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Optional: override the Gemini model (defaults to gemini-flash-lite-latest,
# which is fast and has good free-tier availability).
# GEMINI_MODEL=gemini-flash-lite-latest

# Port the local server listens on.
PORT=3000
